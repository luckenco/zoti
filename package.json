{
  "name": "zoti",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "infra"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p apps/worker && tsc --noEmit -p infra",
    "test": "vitest run",
    "dev": "bun run --filter @zoti/worker dev",
    "deploy": "cd infra && bun alchemy deploy --stage prod"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
