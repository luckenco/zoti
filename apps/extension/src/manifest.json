{
  "manifest_version": 3,
  "name": "Herodotus",
  "version": "0.1.0",
  "description": "Save the current page or selection into Herodotus.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://herodotus-ingress.cloudflare-swimming382.workers.dev/*"],
  "action": {
    "default_title": "Save to Herodotus",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
